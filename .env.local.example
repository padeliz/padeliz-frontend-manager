#########################
#### CREDENTIAL VARS ####
#########################

# Google OAuth Client ID and Secret from Google Cloud Console (Manager Web client)
# Server-only — used by /api/auth/* BFF routes at runtime (never EXPO_PUBLIC_)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate yours at https://applekeygen.expo.app
APPLE_CLIENT_SECRET=

# JWT secret for BFF cookie tokens
JWT_SECRET=


######################
#### GENERAL VARS ####
######################

# Meta Data
EXPO_PUBLIC_APP_NAME='Padeliz Manager'
EXPO_PUBLIC_APP_VERSION='1.0'
EXPO_PUBLIC_BASE_URL=http://localhost:8083

# Configuration
EXPO_PUBLIC_DEBUG_MODE=1
EXPO_PUBLIC_LOG_LEVEL='info'
EXPO_PUBLIC_SCHEME=padeliz-manager://

# API
EXPO_PUBLIC_API_VERSION='v1'
EXPO_PUBLIC_API_BASE_URL='http://localhost:8000'
EXPO_PUBLIC_API_MANAGER_PREFIX='/api/v1/manager'
